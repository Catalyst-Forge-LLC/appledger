{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppLedger v0.1 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "format_version",
    "ledger_id",
    "application_id",
    "repositories",
    "record_roots",
    "bindings"
  ],
  "properties": {
    "format": {
      "const": "appledger"
    },
    "format_version": {
      "type": "string",
      "pattern": "^0\\.1\\.\\d+$"
    },
    "ledger_id": {
      "type": "string",
      "minLength": 1
    },
    "application_id": {
      "type": "string",
      "minLength": 1
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "anyOf": [
          {
            "required": [
              "root"
            ]
          },
          {
            "required": [
              "url"
            ]
          }
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "root": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\.\\.).+$"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "record_roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "family",
          "subject_id",
          "repository_id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "enum": [
              "appfacts",
              "featurefacts",
              "toolfacts",
              "agentfacts",
              "skillfacts",
              "modelfacts"
            ]
          },
          "subject_id": {
            "type": "string",
            "minLength": 1
          },
          "repository_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\.\\.).+$"
          },
          "schema_version": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}
