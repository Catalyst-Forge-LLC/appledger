{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://featurefacts.dev/schema/v0.2.0/feature-record.schema.json",
  "title": "FeatureFacts feature-record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "type",
    "recognition",
    "lifecycle",
    "availability",
    "maturity",
    "audiences",
    "discovery",
    "intent",
    "publication",
    "entry_points",
    "implements",
    "dependencies",
    "docs",
    "tests",
    "observation",
    "evidence",
    "editorial",
    "uncertainty_reasons"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "feature",
        "workflow",
        "integration",
        "surface-cluster"
      ]
    },
    "recognition": {
      "type": "string",
      "enum": [
        "candidate",
        "confirmed"
      ]
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "implemented",
        "released",
        "stub",
        "retired",
        "unknown",
        "undisclosed"
      ]
    },
    "availability": {
      "$ref": "common.schema.json#/$defs/availability"
    },
    "maturity": {
      "type": "string",
      "enum": [
        "stable",
        "experimental",
        "deprecated",
        "unknown",
        "undisclosed"
      ]
    },
    "audiences": {
      "$ref": "common.schema.json#/$defs/audiences"
    },
    "discovery": {
      "$ref": "common.schema.json#/$defs/discovery"
    },
    "intent": {
      "type": "string",
      "enum": [
        "public-discovery",
        "limited-discovery",
        "unknown",
        "undisclosed"
      ]
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "reason"
      ],
      "properties": {
        "scope": {
          "type": "string",
          "enum": [
            "internal",
            "public"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "entry_points": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "implements": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/id"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "evidence_ids"
        ],
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^(external:)?[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "docs": {
      "$ref": "common.schema.json#/$defs/assessment"
    },
    "tests": {
      "$ref": "common.schema.json#/$defs/assessment"
    },
    "observation": {
      "$ref": "common.schema.json#/$defs/observation"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/evidence"
      },
      "minItems": 1
    },
    "editorial": {
      "$ref": "common.schema.json#/$defs/editorial"
    },
    "uncertainty_reasons": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "lifecycle": {
          "type": "string",
          "minLength": 1
        },
        "maturity": {
          "type": "string",
          "minLength": 1
        },
        "intent": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "lifecycle": {
            "enum": [
              "unknown",
              "undisclosed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "uncertainty_reasons": {
            "required": [
              "lifecycle"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "maturity": {
            "enum": [
              "unknown",
              "undisclosed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "uncertainty_reasons": {
            "required": [
              "maturity"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "intent": {
            "enum": [
              "unknown",
              "undisclosed"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "uncertainty_reasons": {
            "required": [
              "intent"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "lifecycle": {
            "const": "retired"
          }
        },
        "required": [
          "lifecycle"
        ]
      },
      "then": {
        "properties": {
          "editorial": {
            "required": [
              "retirement"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "surface-cluster"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "recognition": {
            "const": "candidate"
          }
        }
      }
    }
  ]
}
