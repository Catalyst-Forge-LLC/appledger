{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ForgeTrail profile for AppLedger v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "profile_version",
    "archetype",
    "project_status",
    "current_phase_instance",
    "phase_instances",
    "transitions"
  ],
  "properties": {
    "profile": { "const": "forgetrail" },
    "profile_version": {
      "type": "string",
      "pattern": "^0\\.1\\.\\d+$"
    },
    "archetype": {
      "enum": ["product", "internal-tool", "one-shot"]
    },
    "project_status": {
      "enum": ["active", "wrapped"]
    },
    "current_phase_instance": {
      "type": "string",
      "minLength": 1
    },
    "phase_instances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "phase", "status", "criteria"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "phase": {
            "enum": ["plan", "build", "stabilize", "iterate", "refine", "align", "harden"]
          },
          "status": {
            "enum": ["not_started", "in_progress", "completed", "revisiting"]
          },
          "started_at": { "type": "string", "format": "date-time" },
          "completed_at": { "type": "string", "format": "date-time" },
          "criteria": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text", "status", "evidence_refs"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "text": { "type": "string", "minLength": 1 },
                "status": { "enum": ["pending", "met", "not_applicable"] },
                "evidence_refs": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "disposition_reason": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from_instance", "to_instance", "at", "authorized_by"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "from_instance": { "type": "string", "minLength": 1 },
          "to_instance": { "type": "string", "minLength": 1 },
          "at": { "type": "string", "format": "date-time" },
          "authorized_by": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
