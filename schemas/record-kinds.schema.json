{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AppLedger v0.1 kind contracts",
  "description": "Envelope plus per-kind data. Predicate source/target pairs are normative in 03-records-and-relationships.md.",
  "allOf": [
    {
      "$ref": "record-envelope.schema.json"
    },
    {
      "oneOf": [
        {
          "properties": {
            "kind": { "const": "application" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["purpose", "boundaries", "audience", "survey_scope"],
              "properties": {
                "purpose": { "type": "string", "minLength": 1 },
                "boundaries": { "type": "string", "minLength": 1 },
                "audience": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                },
                "survey_scope": { "type": "string", "minLength": 1 }
              }
            }
          },
          "required": ["data"]
        },
        {
          "properties": {
            "kind": { "const": "goal" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["outcome", "owner", "unmeasured"],
              "properties": {
                "outcome": { "type": "string", "minLength": 1 },
                "owner": { "type": "string", "minLength": 1 },
                "unmeasured": { "type": "boolean" },
                "measurement": { "type": "string", "minLength": 1 }
              },
              "allOf": [
                {
                  "if": {
                    "properties": { "unmeasured": { "const": true } },
                    "required": ["unmeasured"]
                  },
                  "then": { "not": { "required": ["measurement"] } }
                },
                {
                  "if": {
                    "properties": { "unmeasured": { "const": false } },
                    "required": ["unmeasured"]
                  },
                  "then": { "required": ["measurement"] }
                }
              ]
            }
          },
          "required": ["data"]
        },
        {
          "properties": {
            "kind": { "const": "stakeholder" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "interests", "responsibilities"],
              "properties": {
                "role": { "type": "string", "minLength": 1 },
                "interests": { "type": "array", "items": { "type": "string" } },
                "responsibilities": { "type": "array", "items": { "type": "string" } },
                "identity_ref": { "type": "string", "minLength": 1 }
              }
            }
          },
          "required": ["data"]
        },
        {
          "properties": {
            "kind": { "const": "use_case" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["actor", "trigger", "intended_outcome", "flow"],
              "properties": {
                "actor": { "type": "string", "minLength": 1 },
                "trigger": { "type": "string", "minLength": 1 },
                "intended_outcome": { "type": "string", "minLength": 1 },
                "flow": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                },
                "exceptions": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "required": ["data"]
        },
        {
          "properties": {
            "kind": { "const": "concept" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["definition", "aliases", "scope"],
              "properties": {
                "definition": { "type": "string", "minLength": 1 },
                "aliases": { "type": "array", "items": { "type": "string" } },
                "scope": { "type": "string", "minLength": 1 },
                "ambiguity": { "type": "string" }
              }
            }
          },
          "required": ["data"]
        },
        {
          "properties": {
            "kind": { "const": "component" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["responsibility", "boundaries", "source_locators", "interfaces"],
              "properties": {
                "responsibility": { "type": "string", "minLength": 1 },
                "boundaries": { "type": "string", "minLength": 1 },
                "source_locators": { "type": "array", "items": { "type": "string" } },
                "interfaces": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "required": ["data"]
        },
        {
          "properties": {
            "kind": { "const": "decision" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "choice", "rationale", "alternatives", "authority"],
              "properties": {
                "status": {
                  "enum": ["proposed", "accepted", "revisit", "superseded", "withdrawn"]
                },
                "choice": { "type": "string", "minLength": 1 },
                "rationale": { "type": "string", "minLength": 1 },
                "alternatives": { "type": "array", "items": { "type": "string" } },
                "authority": { "type": "string", "minLength": 1 }
              }
            }
          },
          "required": ["data"]
        },
        {
          "properties": {
            "kind": { "const": "constraint" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["restriction", "scope", "origin", "consequence"],
              "properties": {
                "restriction": { "type": "string", "minLength": 1 },
                "scope": { "type": "string", "minLength": 1 },
                "origin": { "type": "string", "minLength": 1 },
                "consequence": { "type": "string", "minLength": 1 },
                "enforcement_evidence": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "required": ["data"]
        },
        {
          "properties": {
            "kind": { "const": "question" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["issue", "status", "affected_ids"],
              "properties": {
                "issue": { "type": "string", "minLength": 1 },
                "status": { "enum": ["open", "answered", "deferred"] },
                "affected_ids": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "required": ["data"]
        },
        {
          "properties": {
            "kind": { "const": "work" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "objective", "acceptance_criteria", "verification_refs"],
              "properties": {
                "status": {
                  "enum": ["proposed", "ready", "in_progress", "blocked", "done", "cancelled"]
                },
                "objective": { "type": "string", "minLength": 1 },
                "intake": { "enum": ["task", "bug", "idea"] },
                "acceptance_criteria": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["id", "text", "status"],
                    "properties": {
                      "id": { "type": "string", "minLength": 1 },
                      "text": { "type": "string", "minLength": 1 },
                      "status": { "enum": ["pending", "met", "not_applicable"] }
                    }
                  }
                },
                "verification_refs": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          "required": ["data"]
        },
        {
          "properties": {
            "kind": { "const": "session" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["session_id", "accomplished", "left_off", "next_steps"],
              "properties": {
                "session_id": { "type": "string", "minLength": 1 },
                "accomplished": { "type": "array", "items": { "type": "string" } },
                "left_off": { "type": "string", "minLength": 1 },
                "next_steps": { "type": "array", "items": { "type": "string" } },
                "companion_outcomes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["tool", "outcome"],
                    "properties": {
                      "tool": { "type": "string", "minLength": 1 },
                      "outcome": { "type": "string", "minLength": 1 },
                      "recorded_at": { "type": "string", "format": "date-time" }
                    }
                  }
                }
              }
            }
          },
          "required": ["data"]
        },
        {
          "properties": {
            "kind": { "const": "lesson" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["context", "problem", "resolution", "limits", "generalization_status"],
              "properties": {
                "context": { "type": "string", "minLength": 1 },
                "problem": { "type": "string", "minLength": 1 },
                "resolution": { "type": "string", "minLength": 1 },
                "limits": { "type": "string", "minLength": 1 },
                "generalization_status": {
                  "enum": ["observed", "candidate", "harvested", "not_generalizable"]
                }
              }
            }
          },
          "required": ["data"]
        },
        {
          "properties": {
            "kind": { "const": "change" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["change_type", "affected_ids", "reason", "evidence_refs"],
              "properties": {
                "change_type": {
                  "enum": ["added", "modified", "renamed", "retired", "restored", "superseded", "corrected"]
                },
                "affected_ids": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                },
                "reason": { "type": "string", "minLength": 1 },
                "evidence_refs": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "operation": { "enum": ["reconciliation", "edit"] },
                "effective_at": { "type": "string", "format": "date-time" },
                "input_fingerprint": { "type": "string", "minLength": 1 }
              }
            }
          },
          "required": ["data"]
        },
        {
          "properties": {
            "kind": { "const": "evidence" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["evidence_kind", "repository_id", "result", "source", "limitations"],
              "properties": {
                "evidence_kind": {
                  "enum": [
                    "owner_statement",
                    "document",
                    "source_extract",
                    "test_run",
                    "runtime_observation",
                    "configuration",
                    "import_snapshot"
                  ]
                },
                "repository_id": { "type": "string", "minLength": 1 },
                "result": { "type": "string", "minLength": 1 },
                "source": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\.\\.).+$"
                },
                "limitations": { "type": "array", "items": { "type": "string" } },
                "subject_id": { "type": "string", "minLength": 1 },
                "digest": { "type": "string", "minLength": 1 },
                "checked_at": { "type": "string", "format": "date-time" }
              }
            }
          },
          "required": ["data"]
        },
        {
          "properties": {
            "kind": { "const": "capability_ref" },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": ["external_ref"],
              "properties": {
                "external_ref": {
                  "type": "string",
                  "pattern": "^binding:[A-Za-z0-9][A-Za-z0-9._-]*#.+$"
                },
                "cached_title": { "type": "string", "minLength": 1 },
                "cached_title_basis": { "const": "derived" }
              },
              "allOf": [
                {
                  "if": { "required": ["cached_title"] },
                  "then": { "required": ["cached_title_basis"] }
                }
              ]
            }
          },
          "required": ["data"]
        }
      ]
    }
  ]
}
