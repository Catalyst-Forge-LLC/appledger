{
  "name": "appledger-site",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "docs:build": "node scripts/build-docs.mjs",
    "dev": "pnpm docs:build && localslip claim appledger-site --port 46002 && filepress dev --host 0.0.0.0",
    "build": "pnpm docs:build && filepress build",
    "preview": "filepress preview",
    "check": "filepress check",
    "ship": "pnpm build && wrangler pages deploy build --project-name=appledger",
    "deploy": "pnpm ship"
  },
  "devDependencies": {
    "getfilepress": "^0.1.42",
    "wrangler": "^4.120.1"
  },
  "pnpm": {
    "overrides": {
      "js-yaml": "3.15.2",
      "sharp": "0.35.4"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "getfilepress",
      "workerd"
    ]
  }
}
